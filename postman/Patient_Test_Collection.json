{
  "info": {
    "name": "Patient Information - Basic Tests",
    "description": "Postman collection for testing patient information endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health & Setup",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if server is running"
          }
        },
        {
          "name": "List Available Tools",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tools",
              "host": ["{{base_url}}"],
              "path": ["tools"]
            },
            "description": "Get list of all available FHIR tools"
          }
        }
      ]
    },
    {
      "name": "Patient Search",
      "item": [
        {
          "name": "Search by Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smith\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by name"
          }
        },
        {
          "name": "Search by First and Last Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by first and last name"
          }
        },
        {
          "name": "Search by Birth Date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"birthDate\": \"1990-01-01\",\n  \"limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by birth date"
          }
        },
        {
          "name": "Search by Name and Birth Date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"birthDate\": \"1990-01-01\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by name and birth date (more specific)"
          }
        },
        {
          "name": "Search by Phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"555-123-4567\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by phone number"
          }
        },
        {
          "name": "Search by Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/search",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "search"]
            },
            "description": "Search for patients by email address"
          }
        }
      ]
    },
    {
      "name": "Patient Details",
      "item": [
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patient/{{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "{{patient_id}}"]
            },
            "description": "Get detailed information for a specific patient by their FHIR Patient ID"
          }
        }
      ]
    },
    {
      "name": "Patient Verification",
      "item": [
        {
          "name": "Verify Patient Identity - Basic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"birthDate\": \"1990-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "verify"]
            },
            "description": "Verify patient identity using name and birth date"
          }
        },
        {
          "name": "Verify Patient Identity - With Phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"birthDate\": \"1990-01-01\",\n  \"phone\": \"555-123-4567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "verify"]
            },
            "description": "Verify patient identity with phone number"
          }
        },
        {
          "name": "Verify Patient Identity - With Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"birthDate\": \"1990-01-01\",\n  \"email\": \"john.smith@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patient/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "verify"]
            },
            "description": "Verify patient identity with email address"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "12345",
      "type": "string",
      "description": "Replace with actual patient ID from search results"
    }
  ]
}
