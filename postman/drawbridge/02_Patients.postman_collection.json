    {
      "name": "SavePatient - new patient (PM, WRITE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.text();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No Unity error', () => pm.expect(body).to.not.match(/Magic Error|\"Error\"\\s*:|not valid for this license|Access is denied/i));",
              "const info = (pm.response.json()[0] || {}).savepatientinfo?.[0] || {};",
              "pm.test('PatientID returned', () => pm.expect(info.PatientID).to.be.ok);",
              "if (info.PatientID) pm.environment.set('pm_patient_id', info.PatientID);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Action\": \"SavePatient\",\n  \"Appname\": \"{{app_name}}\",\n  \"AppUserID\": \"{{ehr_username}}\",\n  \"PatientID\": \"\",\n  \"Token\": \"{{pm_token}}\",\n  \"Parameter1\": \"0\",\n  \"Parameter2\": \"<patient><firstName>{{new_first}}</firstName><lastName>{{new_last}}</lastName><dob>{{new_dob}}</dob><gender>M</gender><street1>1 Test St</street1><city>Boise</city><state>ID</state><zipcode>83702</zipcode><zip>83702</zip></patient>\",\n  \"Parameter3\": \"\",\n  \"Parameter4\": \"\",\n  \"Parameter5\": \"\",\n  \"Parameter6\": \"\",\n  \"Data\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{unity_endpoint}}/json/MagicJson",
        "description": "Creates a patient. Parameter1 = account ID (0 = new account). Parameter2 = demographics XML (firstName, lastName, dob, gender, street1 are required). Verified on the sandbox Oct 16, 2026. Run SearchPatients first so you do not create a duplicate. Saves the new PM ID to {{pm_patient_id}}.\n\nTarget: Veradigm PM. Run the **01 Auth** collection first (token for PM)."
      }
    }
  ]
}
