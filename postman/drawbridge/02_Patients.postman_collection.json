{
  "info": {
    "name": "Drawbridge · 02 Patients",
    "description": "Find, read and create patients. Sandbox and synthetic patients only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SearchPatients (PM)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.text();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No Unity error', () => pm.expect(body).to.not.match(/Magic Error|\"Error\"\\s*:|not valid for this license|Access is denied/i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Action\": \"SearchPatients\",\n  \"Appname\": \"{{app_name}}\",\n  \"AppUserID\": \"{{ehr_username}}\",\n  \"PatientID\": \"\",\n  \"Token\": \"{{pm_token}}\",\n  \"Parameter1\": \"{{search_text}}\",\n  \"Parameter2\": \"\",\n  \"Parameter3\": \"\",\n  \"Parameter4\": \"\",\n  \"Parameter5\": \"\",\n  \"Parameter6\": \"\",\n  \"Data\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{unity_endpoint}}/json/MagicJson",
        "description": "Plain search text: \"Last, First\", \"Last\" or an MRN. Date of birth is not a search field; check it in the results.\n\nTarget: Veradigm PM. Run the **01 Auth** collection first (token for PM)."
      }
    },
    {
      "name": "SearchPatients (EHR)",
      "event": [
        {
