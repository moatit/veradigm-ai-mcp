        "body": {
          "mode": "raw",
          "raw": "{\n  \"Action\": \"GetAvailableSchedule\",\n  \"Appname\": \"{{app_name}}\",\n  \"AppUserID\": \"{{ehr_username}}\",\n  \"PatientID\": \"\",\n  \"Token\": \"{{pm_token}}\",\n  \"Parameter1\": \"{{provider_abbr}}\",\n  \"Parameter2\": \"{{slot_start}}\",\n  \"Parameter3\": \"{{slot_end_exclusive}}\",\n  \"Parameter4\": \"\",\n  \"Parameter5\": \"\",\n  \"Parameter6\": \"\",\n  \"Data\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{unity_endpoint}}/json/MagicJson",
        "description": "One row per day with 5-minute bitmaps (Blocked_Slots = bookable template, Booked_Slots = taken). End date is exclusive: for one day, pass the next day. Each row also gives Scheduling_Location_ID / Scheduling_Department_ID.\n\nTarget: Veradigm PM. Run the **01 Auth** collection first (token for PM)."
      }
    },
    {
      "name": "SaveAppointment (WRITE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.text();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No Unity error', () => pm.expect(body).to.not.match(/Magic Error|\"Error\"\\s*:|not valid for this license|Access is denied/i));",
              "const info = (pm.response.json()[0] || {}).saveappointmentinfo?.[0] || {};",
              "const id = info.Appointment_ID || info.AppointmentID;",
              "pm.test('Appointment_ID returned', () => pm.expect(id).to.be.ok);",
              "if (id) pm.environment.set('appointment_id', id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Action\": \"SaveAppointment\",\n  \"Appname\": \"{{app_name}}\",\n  \"AppUserID\": \"{{ehr_username}}\",\n  \"PatientID\": \"{{pm_patient_id}}\",\n  \"Token\": \"{{pm_token}}\",\n  \"Parameter1\": \"<appt><appointmentDateTime>{{appt_datetime}}</appointmentDateTime><appointmentDuration>15</appointmentDuration><appointmentType>{{appt_type}}</appointmentType><schedulingLocation>{{sched_location}}</schedulingLocation><schedulingDepartment>{{sched_department}}</schedulingDepartment><resource>{{provider_abbr}}</resource><comments>Drawbridge sandbox test</comments><schedulingLocationID>{{sched_location_id}}</schedulingLocationID><schedulingDepartmentID>{{sched_department_id}}</schedulingDepartmentID></appt>\",\n  \"Parameter2\": \"\",\n  \"Parameter3\": \"\",\n  \"Parameter4\": \"\",\n  \"Parameter5\": \"\",\n  \"Parameter6\": \"\",\n  \"Data\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{unity_endpoint}}/json/MagicJson",
        "description": "Books a visit. appointmentDateTime = \"MM/DD/YYYY HH:mm\" (24-hour). Check the slot with GetAvailableSchedule first. Saves Appointment_ID to {{appointment_id}}.\n\nTarget: Veradigm PM. Run the **01 Auth** collection first (token for PM)."
      }
    },
