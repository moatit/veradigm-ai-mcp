    {
      "name": "SetAppointmentStatus - cancel (WRITE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.text();",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No Unity error', () => pm.expect(body).to.not.match(/Magic Error|\"Error\"\\s*:|not valid for this license|Access is denied/i));",
              "pm.test('Status Success', () => pm.expect(pm.response.text()).to.match(/\"Status\"\\s*:\\s*\"success\"/i));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = new Date().toLocaleTimeString('en-US', { timeZone: 'America/Boise', hour12: false, hour: '2-digit', minute: '2-digit' });",
              "pm.variables.set('clinic_hhmm', String(Number(t.replace(':', ''))));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Action\": \"SetAppointmentStatus\",\n  \"Appname\": \"{{app_name}}\",\n  \"AppUserID\": \"{{ehr_username}}\",\n  \"PatientID\": \"{{pm_patient_id}}\",\n  \"Token\": \"{{pm_token}}\",\n  \"Parameter1\": \"{{appointment_id}}\",\n  \"Parameter2\": \"X\",\n  \"Parameter3\": \"\",\n  \"Parameter4\": \"{{clinic_hhmm}}\",\n  \"Parameter5\": \"\",\n  \"Parameter6\": \"{{cancel_reason_id}}\",\n  \"Data\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{unity_endpoint}}/json/MagicJson",
        "description": "P1 appointment ID, P2 status (X = cancel, C = confirm), P4 clinic time HHMM, P5 confirmation result ID (confirm only), P6 cancellation reason ID. Success = Status \"Success\". This action ignores PatientID, so check the appointment is the right patient's first.\n\nTarget: Veradigm PM. Run the **01 Auth** collection first (token for PM)."
      }
    }
