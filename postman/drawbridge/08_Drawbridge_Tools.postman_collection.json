{
  "info": {
    "name": "Drawbridge · 08 Drawbridge tool API",
    "description": "Tests the Drawbridge server itself (local `npm run server:unity` or the live site), not Veradigm directly. Drawbridge handles the Veradigm login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{drawbridge_url}}/health"
      }
    },
    {
      "name": "List tools",
      "request": {
        "method": "GET",
        "url": "{{drawbridge_url}}/tools"
      }
    },
    {
      "name": "Search patient",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Not a tool failure', () => pm.expect(pm.response.text()).to.not.match(/\"success\"\\s*:\\s*false/));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "x-drawbridge-key",
            "value": "{{drawbridge_tool_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"unity_search_patients\",\n  \"args\": {\n    \"lastName\": \"kumar1\",\n    \"firstName\": \"ram1\",\n    \"dateOfBirth\": \"01/01/1980\"\n  },\n  \"call\": {\n    \"call_id\": \"postman-{{$timestamp}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{drawbridge_url}}/api/retell",
        "description": "Calls the Drawbridge tool unity_search_patients the way the phone agent does. Returns the sentence the agent would say."
      }
    },
