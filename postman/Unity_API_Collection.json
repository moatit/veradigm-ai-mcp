        {
          "name": "4.1 Create Patient → Book Appointment",
          "item": [
            {
              "name": "Step 1: Create Patient",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "if (jsonData.result && jsonData.result.patientId) {",
                      "    pm.collectionVariables.set('new_patient_id', jsonData.result.patientId);",
                      "    pm.test('Patient created', function() {",
                      "        pm.expect(jsonData.result.success).to.be.true;",
                      "    });",
                      "}"
