  "item": [
    {
      "name": "0. Direct Unity API (Raw)",
      "description": "Direct calls to Unity API endpoints for testing authentication and connectivity",
      "item": [
        {
          "name": "0.1 GetToken (PM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var token = pm.response.text().replace(/\"/g, '');",
                  "    pm.collectionVariables.set('security_token', token);",
                  "    pm.test('Token obtained successfully', function() {",
                  "        pm.expect(token).to.have.length.above(30);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Username\": \"{{ubiquity_id_pm}}{{unity_svc_username}}\",\n  \"Password\": \"{{unity_svc_password}}\"\n}"
            },
            "url": {
              "raw": "{{unity_base_url}}/json/GetToken",
              "host": ["{{unity_base_url}}"],
              "path": ["json", "GetToken"]
            },
            "description": "Get security token from Unity API for Practice Management"
          },
          "response": []
        },
