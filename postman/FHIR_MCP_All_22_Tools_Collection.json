{
  "info": {
    "name": "FHIR MCP - All 22 Tools",
    "description": "Postman collection for all FHIR MCP tools. Use with localhost (http://localhost:3000) or tunnel URL. Set 'base_url' in environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "patient_id", "value": "", "type": "string" },
    { "key": "provider_id", "value": "", "type": "string" },
    { "key": "location_id", "value": "", "type": "string" },
    { "key": "appointment_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Check if FHIR MCP server is running."
          }
        },
        {
          "name": "List Tools",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tools",
            "description": "List all 22 FHIR MCP tools."
          }
        },
        {
          "name": "MCP Initialize",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"initialize\",\n  \"id\": 1\n}"
            },
            "url": "{{base_url}}/",
            "description": "MCP protocol initialize."
          }
        },
        {
          "name": "MCP tools/list",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/list\",\n  \"id\": 2\n}"
            },
            "url": "{{base_url}}/",
            "description": "List tools via MCP JSON-RPC."
          }
        }
      ]
    },
    {
      "name": "1. Patient Tools (3)",
      "item": [
        {
          "name": "search_patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"search_patient\",\n    \"arguments\": {\n      \"lastName\": \"Smith\",\n      \"firstName\": \"John\",\n      \"birthDate\": \"1980-01-15\",\n      \"_count\": 10\n    }\n  },\n  \"id\": 1\n}"
            },
            "url": "{{base_url}}/",
            "description": "Search for patients by name, DOB, phone, email, or MRN. Date format: YYYY-MM-DD"
          }
        },
        {
          "name": "get_patient_details",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_patient_details\",\n    \"arguments\": {\n      \"patientId\": \"{{patient_id}}\"\n    }\n  },\n  \"id\": 2\n}"
            },
            "url": "{{base_url}}/",
            "description": "Get full patient details by patient ID."
          }
        },
        {
          "name": "verify_patient_identity",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"verify_patient_identity\",\n    \"arguments\": {\n      \"patientId\": \"{{patient_id}}\",\n      \"birthDate\": \"1980-01-15\",\n      \"lastName\": \"Smith\"\n    }\n  },\n  \"id\": 3\n}"
            },
            "url": "{{base_url}}/",
            "description": "Verify patient identity with DOB and name."
          }
        }
      ]
    },
