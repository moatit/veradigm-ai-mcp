{
  "info": {
    "name": "Veradigm MCP - Localhost Test Server",
    "description": "Simple collection to test your local HTTP server on localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health & Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["health"]
            },
            "description": "Check if the server is running"
          },
          "response": []
        },
        {
          "name": "Test Authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/test/auth",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["test", "auth"]
            },
            "description": "Test Veradigm authentication (server handles OAuth automatically)"
          },
          "response": []
        },
        {
          "name": "List Available Tools",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/tools",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["tools"]
            },
            "description": "Get list of all available MCP tools"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Patient Operations",
      "item": [
        {
          "name": "Search Patient by Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smith\",\n  \"birthDate\": \"1990-01-01\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/test/search-patient",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["test", "search-patient"]
            },
            "description": "Search for patients by name and optional birth date"
          },
          "response": []
        },
        {
          "name": "Get Patient Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"69006\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/test/patient-details",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["test", "patient-details"]
            },
            "description": "Get detailed information about a specific patient"
          },
          "response": []
        }
      ]
    }
  ]
}
