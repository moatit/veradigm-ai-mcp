# =============================================================================
# Production Environment Variables
# =============================================================================
# Copy this file to .env.prod and fill in your actual values.
# Then run: ./scripts/setup-ssm-params.sh
# This uploads all secrets to AWS SSM Parameter Store.
#
# DO NOT COMMIT .env.prod — it contains secrets!
# =============================================================================

# ---- AWS Configuration ----
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# ---- Deployment ----
# IMAGE_TAG=latest

# ---- FHIR MCP Server ----
CLIENT_ID=your_fhir_client_id
CLIENT_SECRET=your_fhir_client_secret
FHIR_BASE_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/fhir/CP00101
FHIR_BASE_URL_PRODUCTION=
AUTH_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/authorizationV2/CP00101/connect/authorize
TOKEN_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/authorizationV2/CP00101/connect/token
AUTH_URL_PRODUCTION=
TOKEN_URL_PRODUCTION=
TOKEN_CACHE_TTL=3600
CACHE_ENABLED=true
LOG_LEVEL=info

# ---- Unity MCP Server ----
UNITY_APP_NAME=your_unity_app_name
UNITY_SVC_USERNAME=your_unity_svc_username
UNITY_SVC_PASSWORD=your_unity_svc_password
UNITY_EHR_USERNAME=your_ehr_username
UNITY_EHR_PASSWORD=your_ehr_password
UNITY_UBIQUITY_ENDPOINT=https://open-uny-ubiquity.platform.veradigm.com/UnityService.svc
UNITY_UBIQUITY_ID_PM=VHCP001PM:PMGA02^8^
UNITY_UBIQUITY_ID_EHR=AHMCP00101:CP00101^1^
UNITY_TOKEN_CACHE_TTL=1140
UNITY_TOKEN_REFRESH_BUFFER=60
UNITY_PM_SHARE_EHR_LOGIN=false
UNITY_PM_USERNAME=your_pm_username
UNITY_PM_PASSWORD=your_pm_password
UNITY_TASK_TYPE=
UNITY_TASK_TARGET=

# ---- Drawbridge ----
DRAWBRIDGE_TOOL_KEY=generate-with-openssl-rand-hex-32
DRAWBRIDGE_AGENT_KEY=generate-with-openssl-rand-hex-32
DRAWBRIDGE_SESSION_SECRET=generate-with-openssl-rand-hex-32
DRAWBRIDGE_USERS_FILE=/app/data/staff-users
DRAWBRIDGE_TRUST_PROXY=1
DRAWBRIDGE_FHIR_REST_ROUTES=off
DRAWBRIDGE_PUBLIC_URL=https://unity.veradigmai.com
RETELL_WEBHOOK_API_KEY=from-retell-webhook-badged-key
CLINIC_TIMEZONE=America/Boise
INTAKE_FILING=off
INTAKE_SAVE_DOCUMENT_FORMAT_CONFIRMED=
INTAKE_MATCH_RULE=name_dob
INTAKE_REVIEW_USER=

# ---- On-call notebook ----
ONCALL_USERNAME=
ONCALL_PASSWORD=
ONCALL_SESSION_SECRET=
CLINIC_HOURS=
ONCALL_ALERT_TO=

# ---- Admin Portal ----
# DB runs as a Docker container alongside the app. Only the password is needed.
DB_PASSWORD=veradigm2026
NEXTAUTH_URL=https://your-alb-dns-or-domain.com
NEXTAUTH_SECRET=generate-a-strong-random-secret-here
ADMIN_EMAIL=admin@veradigm.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_API_KEY=generate-a-random-api-key
