# =============================================================================
# Veradigm ? Local Development Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =============================================================================

# ---- Environment ----
NODE_ENV=sandbox

# ---- FHIR MCP Server (Port 3000) ----
CLIENT_ID=your_fhir_client_id
CLIENT_SECRET=your_fhir_client_secret
FHIR_BASE_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/fhir/CP00101
AUTH_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/authorizationV2/CP00101/connect/authorize
TOKEN_URL_SANDBOX=https://fhir.fhirpoint.open.allscripts.com/fhirroute/authorizationV2/CP00101/connect/token
# FHIR_BASE_URL_PRODUCTION=
# AUTH_URL_PRODUCTION=
# TOKEN_URL_PRODUCTION=
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
TOKEN_CACHE_TTL=3600
CACHE_ENABLED=true
LOG_LEVEL=info

# ---- Unity MCP Server (Port 3001) ----
UNITY_APP_NAME=your_unity_app_name
UNITY_SVC_USERNAME=your_unity_svc_username
UNITY_SVC_PASSWORD=your_unity_svc_password
UNITY_EHR_USERNAME=your_ehr_username
UNITY_EHR_PASSWORD=your_ehr_password
UNITY_UBIQUITY_ENDPOINT=https://open-uny-ubiquity.platform.veradigm.com/UnityService.svc
UNITY_UBIQUITY_ID_PM=VHCP001PM:PMGA02^8^
UNITY_UBIQUITY_ID_EHR=AHMCP00101:CP00101^1^
UNITY_TOKEN_CACHE_TTL=1140
UNITY_TOKEN_REFRESH_BUFFER=60
UNITY_MCP_SERVER_PORT=3001
UNITY_MCP_SERVER_HOST=localhost

# ---- Admin Portal (Port 5001) ----
DB_PASSWORD=change-me-long-random
NEXTAUTH_URL=http://localhost:5001
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
ADMIN_EMAIL=admin@veradigm.com
ADMIN_PASSWORD=change-me-12-plus-characters
ADMIN_API_KEY=change-me-long-random
MCP_CHANNEL=API

# --- Unity action names (see src/unity/config/unity-endpoints.ts) ---
# The names are the ones declared to Veradigm (docs/drawbridge/UNITY_ACTIONS_FOR_CERTIFICATION.md).
# UNITY_ACTION_<KEY> may only repeat that key's declared name: any other value stops the server at
# start-up (a different action needs Veradigm recertification and a code change), e.g. allowed:
# UNITY_ACTION_GET_APPOINTMENTS=GetScheduleByPatientID

# Staff tasks (SaveTask)
UNITY_TASK_TYPE=Call Patient
UNITY_TASK_TARGET=

# Booking (SaveAppointment), all optional. Appointment type when the caller gives none
# (default: the provider's Default_Appointment_Type_ID); preferred scheduling department when a slot
# is open in several; cancellation reason when the caller's reason matches none.
# UNITY_DEFAULT_APPOINTMENT_TYPE=OV
# UNITY_DEFAULT_SCHEDULING_DEPARTMENT=
# UNITY_DEFAULT_CANCEL_REASON=Patient Cancelled
# Extra <appt> elements, sent only when set (the sandbox does not need them):
# UNITY_APPT_REFER_DR=  UNITY_APPT_COVERAGE_TYPE=  UNITY_APPT_VISIT_TYPE=  UNITY_APPT_REFERRAL_REQUIRED=  UNITY_APPT_AILMENT_ID=

# FHIR appointment tools and get_medication_statements are disabled (not in Veradigm's FHIR API)
FHIR_ENABLE_APPOINTMENT_TOOLS=false

# On-call notebook (Unity container, /oncall). Notebook is off unless username+password are set.
ONCALL_USERNAME=
ONCALL_PASSWORD=
ONCALL_SESSION_SECRET=
CALL_RECORDS_DIR=./data
CLINIC_TIMEZONE=America/Boise
CLINIC_HOURS=Mon-Fri 08:00-17:00
ONCALL_ALERT_TO=

# ---- Drawbridge security settings (docs/drawbridge/SECURITY_CONTROLS.md) ----
# Key for the machine endpoints (MCP, /tools, /api/<module>, /test/*, /diagnostics/*).
# REQUIRED: without it those endpoints answer 503 "not configured".
DRAWBRIDGE_TOOL_KEY=
# The phone agent's own key (Retell custom functions, POST /api/retell, header x-drawbridge-key). Different from
# DRAWBRIDGE_TOOL_KEY; when set it is the only key /api/retell accepts and no other route accepts it.
# Unset: /api/retell falls back to DRAWBRIDGE_TOOL_KEY.
DRAWBRIDGE_AGENT_KEY=
# Staff app: cookie signing key (set it, or everyone is signed out at each restart)
DRAWBRIDGE_SESSION_SECRET=
# Named staff logins (npm run staff:user -- <name> --totp); disables the single login
# DRAWBRIDGE_USERS_FILE=/run/drawbridge/drawbridge-users
# Every staff sign-in needs a TOTP code (forced on in production; "off" only for local development)
# DRAWBRIDGE_REQUIRE_TOTP=on
# DRAWBRIDGE_PASSWORD_MAX_AGE_DAYS=90
# DRAWBRIDGE_IDLE_MINUTES=15
# DRAWBRIDGE_LOGIN_MAX_FAILS=5
# DRAWBRIDGE_LOGIN_WINDOW_MIN=15
# DRAWBRIDGE_LOGIN_IP_MAX_FAILS=30
# Behind proxies: the number of hops that append to X-Forwarded-For (nginx alone 1; Cloudflare tunnel + nginx 2),
# so the login lockout and the audit see client IPs
# DRAWBRIDGE_TRUST_PROXY=1
# Browser origins allowed to call the APIs (comma-separated, exact). Unset = same origin only.
# DRAWBRIDGE_CORS_ORIGINS=https://admin.example.com
# Security alerts (docs/drawbridge/HIPAA_TECHNICAL_SAFEGUARDS.md): exports / patient-record views per user per hour
# DRAWBRIDGE_EXPORT_ALERT_PER_HOUR=20
# DRAWBRIDGE_VIEW_ALERT_PER_HOUR=200
# Staff-only tools on the agent endpoints (only for a staff voice assistant, never the patient line)
# DRAWBRIDGE_AGENT_STAFF_TOOLS=off
# FHIR server REST/test routes (patient IDs in URLs): off in production unless "on"
# DRAWBRIDGE_FHIR_REST_ROUTES=

# ---- Per-client settings ----
# Practice name (staff header, outreach agent, intake receiving practice). No default.
CLINIC_NAME=
# INTAKE_SCAN_INTERVAL_SEC=30
# INTAKE_OCR_WAIT_SEC=60

# ---- Retention (days) ----
# CALL_RECORDS_RETENTION_DAYS=30
# OUTREACH_RETENTION_DAYS=30
# INTAKE_RETENTION_DAYS=30
# INTAKE_RECORD_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=2190

# ---- Veradigm diagnostics and auth timing ----
# UNITY_AUTH_TIMEOUT_MS=30000
# UNITY_SERVER_INFO_REFRESH_HOURS=6
# UNITY_LASTLOGS_MIN_INTERVAL_SEC=60

# ---- Veradigm health check, system status and token keep-warm ----
# UNITY_HEALTH_CHECK_MIN=15           # probe (GetServerInfo) every N minutes (default 15; never below 2, Veradigm polling rule); off = disabled
# UNITY_HEALTH_TIMEOUT_SEC=15
# UNITY_HEALTH_FAILS_TO_DOWN=2        # consecutive failed probes before a system is DOWN
# UNITY_FAIL_FAST_WHEN_DOWN=on        # agent tools answer RECORDS_UNAVAILABLE at once while DOWN
# UNITY_KEEP_WARM_MINUTES=30          # renew the Veradigm session before it expires while calls ran in the last N minutes (0 = off)
# UNITY_KEEP_WARM_LEAD_SEC=120
# UNITY_SEARCH_VISITS_BUDGET_MS=2500  # upcoming visits with a verified search match (0 = off)

# ---- MOATiT help-desk alerts (Veradigm down / reminder / recovered; no PHI) ----
# HELPDESK_SMTP_URL=smtps://user:password@smtp.example.com:465   # secret: .env / SSM only; smtp:// requires STARTTLS
# HELPDESK_ALERT_TO=help@moatit.com
# HELPDESK_ALERT_FROM=drawbridge-alerts@moatit.com
# HELPDESK_WEBHOOK_URL=               # https ticketing / chat webhook (JSON POST)
# HELPDESK_WEBHOOK_SECRET=            # optional: x-drawbridge-signature: sha256=<HMAC of the body>
# HELPDESK_REMINDER_HOURS=4
# DRAWBRIDGE_PUBLIC_URL=https://drawbridge.moatit.dev   # link to the status screen in alerts

# ---- Phone agent call start (Retell inbound-call webhook: POST /webhooks/retell-inbound) ----
# Verified with x-retell-signature (Retell signs with the API key that has the "webhook" badge:
# Retell dashboard > Settings > API Keys) or RETELL_WEBHOOK_SECRET (x-drawbridge-webhook-secret).
# RETELL_WEBHOOK_API_KEY=            # secret: the webhook-badged key; unset = RETELL_API_KEY. Also verifies /webhooks/retell.
# DRAWBRIDGE_FHIR_TOOLS=off           # fhir_tools variable: the backup chart tools stay off until FHIR is approved
# NODE_ENV=production requires UNITY_UBIQUITY_ENDPOINT, UNITY_UBIQUITY_ID_PM and UNITY_UBIQUITY_ID_EHR.
