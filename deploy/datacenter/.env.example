# Drawbridge shadow intake on MOATiT's IKI fax server. Copy to .env (chmod 600). Never commit .env.

# ---- Paths on this server ----
# DATA_DIR must be on the encrypted volume, owned by uid/gid 1001 (README: "Prepare the server").
DATA_DIR=/srv/drawbridge-shadow/data
# Where Express Lab's files land (mounted read-only; nothing in it is moved or changed).
EXPRESS_LAB_DIR=/srv/express-lab/incoming
# The archive of old IKI faxes for the bulk import (read-only).
OLD_FAX_DIR=/srv/old-faxes
# Optional: Express Lab files older than this day are not taken in (YYYY-MM-DD).
INTAKE_WATCH_SINCE=

# ---- Staff screens ----
# Address of this server on the staff network, and the HTTPS port.
BIND_ADDR=127.0.0.1
HTTPS_PORT=8443
# openssl rand -hex 32
DRAWBRIDGE_SESSION_SECRET=

# ---- Patient search ----
# Main path once IKI's Veradigm activation exists: the live, read-only search. Turn the egress on:
COMPOSE_PROFILES=veradigm
UNITY_APP_NAME=
UNITY_SVC_USERNAME=
UNITY_SVC_PASSWORD=
UNITY_EHR_USERNAME=
UNITY_EHR_PASSWORD=
UNITY_PM_USERNAME=
UNITY_PM_PASSWORD=
UNITY_UBIQUITY_ENDPOINT=https://unity-host.example/UnityService.svc
UNITY_UBIQUITY_ID_PM=
UNITY_UBIQUITY_ID_EHR=
# The host name in UNITY_UBIQUITY_ENDPOINT: the only host the stack may reach.
VERADIGM_UNITY_HOST=unity-host.example
# Early start without Veradigm: leave the UNITY_* lines empty, remove COMPOSE_PROFILES, and set
# INTAKE_ROSTER_CSV=/run/drawbridge/lists/roster.csv
# Category list, used when GetDocumentType is not available (always set it for an early start):
INTAKE_CATEGORIES_CSV=/run/drawbridge/lists/categories.csv

# ---- Staff filing observer (live Veradigm only) ----
INTAKE_OBSERVE=on
INTAKE_OBSERVE_QUEUE_TYPE=-1000999
INTAKE_OBSERVE_MAX_DAYS=7

# ---- MOATiT Fax (same server, fax-link network) ----
MOATIT_FAX_WEBHOOK_SECRET=
MOATIT_FAX_BASE_URL=http://moatit-fax-api:8000
MOATIT_FAX_API_KEY=

# ---- Intake ----
INTAKE_PRACTICE_NAME=Idaho Kidney Institute
INTAKE_BATCH_SENDERS=Express Lab
# MOATiT standard: name + date of birth are the two identifiers; an SSN last 4 or address on the
# document is checked as a third (disagreeing = staff). See docs/drawbridge/FAX_INTAKE_ADDON.md "Matching".
INTAKE_MATCH_RULE=name_dob
# Shadow mode files nothing; these shape what it records (always-to-a-person documents, the category).
# Clinic rules (docs/drawbridge/FAX_INTAKE_ADDON.md "Clinic rules"). Idaho Kidney Institute's answers (Oct 13, 2026):
# documents never auto-filed, even with a perfect patient match (unset = all four; none = off)
INTAKE_ALWAYS_PERSON=records_request,prior_auth,refill_request,referral
# review task to the ordering provider on the document (matched to one Veradigm EHR user), else INTAKE_REVIEW_USER
INTAKE_TASK_TARGET=ordering_provider
# Veradigm EHR user for the review task when there is no ordering provider match (unset: no task)
INTAKE_REVIEW_USER=
# who gets critical results' High-priority "CRITICAL" task (unset: the normal recipient above; IKI hasn't named one yet)
INTAKE_CRITICAL_NOTIFY=
# no review task for results collected on the day of the patient's appointment (critical results always notify)
INTAKE_SAME_DAY_NO_NOTIFY=on
# IKI's lab category; without it an EHR listing both "Labs/Procedures" and "Lab Results" gets "Labs/Procedures"
INTAKE_CATEGORY_MAP='{"lab_result":"Lab Results"}'
CLINIC_TIMEZONE=America/Boise
OCR_CONCURRENCY=2
