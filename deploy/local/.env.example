# Drawbridge local dev stack. Copy to .env and fill in. NEVER commit .env.
# Sandbox values only. Ask Kanhaiya for the FHIR client and Unity EHR/PM user;
# the Unity service user/password are the ones recreated in the Veradigm developer portal on Oct 8.

# ---- Veradigm EHR · FHIR (sandbox) ----
CLIENT_ID=
CLIENT_SECRET=
FHIR_BASE_URL_SANDBOX=https://scmlatestdev.open.allscripts.com/FHIR
AUTH_URL_SANDBOX=https://scmlatestdev.open.allscripts.com/oauth2/authorize
TOKEN_URL_SANDBOX=https://scmlatestdev.open.allscripts.com/oauth2/token

# ---- Veradigm PM/EHR · Unity (sandbox) ----
UNITY_UBIQUITY_ENDPOINT=https://ubiquityunity.azurewebsites.net/UnityService.svc
UNITY_APP_NAME=
UNITY_SVC_USERNAME=
UNITY_SVC_PASSWORD=
UNITY_EHR_USERNAME=
UNITY_EHR_PASSWORD=
UNITY_UBIQUITY_ID_PM=
UNITY_UBIQUITY_ID_EHR=
UNITY_TASK_TYPE=Call Patient
UNITY_TASK_TARGET=

# ---- Drawbridge platform ----
# Staff app login (https://drawbridge.moatit.dev/app)
DRAWBRIDGE_USERNAME=
DRAWBRIDGE_PASSWORD=
DRAWBRIDGE_SESSION_SECRET=
# Shared key Retell sends as header x-drawbridge-key on every custom function. REQUIRED: without it every
# tool, test and diagnostics endpoint answers 503 "not configured".
DRAWBRIDGE_TOOL_KEY=
# Behind the local nginx gateway / tunnel: one proxy hop, so the staff login lockout sees client IPs
DRAWBRIDGE_TRUST_PROXY=1
# Practice name shown in the staff app and said by the outreach agent (no default in code)
CLINIC_NAME=
CLINIC_HOURS=Mon-Fri 08:00-17:00
ONCALL_ALERT_TO=
# Activity: audit log + Retell call events at POST /webhooks/retell (see src/platform/modules/activity/README.md).
# Webhook stays closed (503) until RETELL_WEBHOOK_SECRET is set, sent as header x-drawbridge-webhook-secret.
RETELL_WEBHOOK_SECRET=
AUDIT_RETENTION_DAYS=30
# AUDIT_DIR defaults to CALL_RECORDS_DIR (/app/data in Docker)
# Document intake (fax + drop folder + uploads; see src/platform/modules/intake/README.md).
# Webhook POST /webhooks/moatit-fax stays closed (503) until MOATIT_FAX_WEBHOOK_SECRET is set (same value as in MOATiT Fax).
MOATIT_FAX_WEBHOOK_SECRET=
# MOATiT Fax enterprise API (base URL without /api/v1/enterprise) and a fax:read API key
MOATIT_FAX_BASE_URL=
MOATIT_FAX_API_KEY=
# off (default: read + match + queue only) | review | auto. Filing also needs the confirmed save format below.
INTAKE_FILING=off
# Set true only after SaveDocumentImage is verified on the sandbox with the owner's OK
INTAKE_SAVE_DOCUMENT_FORMAT_CONFIRMED=false
# Patient matching, MOATiT standard (Oct 11, 2026): the two identifiers are the exact name + date of
# birth (one patient, nobody look-alike, no conflicting MRN or phone). An SSN last 4 or address on the
# document is checked too: agreeing raises confidence, disagreeing sends the document to staff.
# Unset or any other value: the stricter two_identifiers rule (name + DOB + MRN, phone, SSN-4 or address).
INTAKE_MATCH_RULE=name_dob
INTAKE_DROP_DIR=/app/intake/inbox
INTAKE_MAX_FILE_MB=25
INTAKE_RETENTION_DAYS=30
# Senders of multi-patient batch reports (comma-separated, case-insensitive: part of the lab's name
# as printed, or its 10-digit fax number). Every page of their files must show the patient (name +
# DOB or MRN) or the whole file goes to staff; files with several patients are split into one
# document per patient, and each part is matched and filed on its own. IKI: the Express Lab daily file.
INTAKE_BATCH_SENDERS=
# Split files that show several patients into one document per patient (on, default) or send them to staff (off)
INTAKE_SPLIT=on
# Senders whose documents always wait for staff, even when matched (optional; no longer needed for batch labs)
INTAKE_NO_AUTO_SENDERS=
# Clinic rules (docs/drawbridge/FAX_INTAKE_ADDON.md "Clinic rules"). Idaho Kidney Institute's answers (Oct 13, 2026):
# documents never auto-filed, even with a perfect patient match (unset = all four; none = off)
INTAKE_ALWAYS_PERSON=records_request,prior_auth,refill_request,referral
# review task to the ordering provider on the document (matched to one Veradigm EHR user), else INTAKE_REVIEW_USER
INTAKE_TASK_TARGET=ordering_provider
# Veradigm EHR user for the review task when there is no ordering provider match (unset: no task)
INTAKE_REVIEW_USER=
# who gets critical results' High-priority "CRITICAL" task (unset: the normal recipient above; IKI hasn't named one yet)
INTAKE_CRITICAL_NOTIFY=
# no review task for results collected on the day of the patient's appointment (critical results always notify)
INTAKE_SAME_DAY_NO_NOTIFY=on
# IKI's lab category; without it an EHR listing both "Labs/Procedures" and "Lab Results" gets "Labs/Procedures"
INTAKE_CATEGORY_MAP='{"lab_result":"Lab Results"}'

# ---- Retell (outbound calls: reminders, no-show follow-up, recalls) ----
RETELL_API_KEY=
RETELL_FROM_NUMBER=+12089043641
RETELL_OUTBOUND_AGENT_ID=
# Safety: outbound calls only go to numbers on this list until it is emptied for production.
OUTBOUND_ALLOWLIST=

# ---- Drawbridge Admin (call reports, monitoring, client API keys) at http://127.0.0.1:8096 ----
ADMIN_PORTAL_SRC=../../../veradigmai-repo
ADMIN_DB_PASSWORD=
ADMIN_NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Key the Drawbridge servers use to send tool-call logs (seeded as the "RetellAI Voice Agent" client)
ADMIN_API_KEY=
ADMIN_PUBLIC_URL=http://127.0.0.1:8096

# Scheduling (Veradigm PM): resource abbreviations searched when the caller names no provider
UNITY_SCHEDULING_RESOURCES=
UNITY_SLOT_MINUTES=15
CLINIC_TIMEZONE=America/Boise

# client_secret (default) or private_key_jwt
FHIR_AUTH_MODE=client_secret
